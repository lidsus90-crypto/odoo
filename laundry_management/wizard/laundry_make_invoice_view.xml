<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_make_invoice_form" model="ir.ui.view">
        <field name="name">laundry.make.invoice.form</field>
        <field name="model">laundry.make.invoice</field>
        <field name="arch" type="xml">
            <form string="Crear Facturas">
                <group>
                    <field name="invoice_date"/>
                    <field name="grouped"/>
                </group>
                <footer>
                    <button name="make_invoices" string="Crear Facturas"
                            type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
