<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_laundry_order" model="ir.actions.report">
        <field name="name">Orden de Servicio</field>
        <field name="model">laundry.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">laundry_management_lidsus.report_laundry_order_doc</field>
        <field name="report_file">laundry_management_lidsus.report_laundry_order_doc</field>
        <field name="binding_model_id" ref="model_laundry_management"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_laundry_order_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Orden de Servicio:
                            <span t-field="o.tag_asignado"/>
                        </h2>
                        <div class="row mt16">
                            <div class="col-6">
                                <strong>Cliente:</strong>
                                <span t-field="o.partner_id.name"/>
                                <br/>
                                <strong>Etiqueta:</strong>
                                <span t-field="o.codigo_orden_servicio"/>
                                <br/>
                                <strong>Encargado:</strong>
                                <span t-field="o.user_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Fecha Recepción:</strong>
                                <span t-field="o.clean_start_time"/>
                                <br/>
                                <strong>Fecha Entrega:</strong>
                                <span t-field="o.clean_end_time"/>
                                <br/>
                                <strong>Estado:</strong>
                                <span t-field="o.state"/>
                            </div>
                        </div>
                        <table class="table table-sm mt16">
                            <thead>
                                <tr>
                                    <th>Prenda</th>
                                    <th>Descripción</th>
                                    <th>Color</th>
                                    <th>Cant.</th>
                                    <th>Método</th>
                                    <th>Tiempo</th>
                                    <th>P.Unit</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.service_lines" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-field="line.product_id.name"/>
                                        </td>
                                        <td>
                                            <span t-field="line.name"/>
                                        </td>
                                        <td>
                                            <span t-field="line.color"/>
                                        </td>
                                        <td>
                                            <span t-field="line.product_uom_qty"/>
                                        </td>
                                        <td>
                                            <span t-field="line.method_id.descripcion_mtd"/>
                                        </td>
                                        <td>
                                            <span t-field="line.tiempo"/>
                                        </td>
                                        <td>
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td>
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7" class="text-right">
                                        <strong>Subtotal:</strong>
                                    </td>
                                    <td>
                                        <span t-field="o.amount_untaxed"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="7" class="text-right">
                                        <strong>Impuestos:</strong>
                                    </td>
                                    <td>
                                        <span t-field="o.amount_tax"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="7" class="text-right">
                                        <strong>Total:</strong>
                                    </td>
                                    <td>
                                        <span t-field="o.amount_total"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                        <p t-if="o.informacion">
                            <strong>Observación:</strong>
                            <span t-field="o.informacion"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
