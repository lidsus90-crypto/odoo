<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario Reclamo -->
    <record id="view_laundry_claim_form" model="ir.ui.view">
        <field name="name">laundry.claim.form</field>
        <field name="model">laundry.claim</field>
        <field name="arch" type="xml">
            <form string="Orden de Reclamo">
                <header>
                    <button name="laundry_claim_enviado" string="Enviar"
                            type="object" class="oe_highlight"
                            invisible="state != 'received' or lorder_id"/>

                    <button name="laundry_claim_enproceso" string="En Proceso"
                            type="object"
                            invisible="state != 'sent' or lorder_id"/>

                    <button name="laundry_claim_entransito" string="En Tránsito"
                            type="object"
                            invisible="state != 'in_process' or lorder_id"/>

                    <button name="laundry_claim_listo" string="Listo"
                            type="object"
                            invisible="state != 'in_transit' or lorder_id"/>

                    <button name="confirmar" string="Entregar"
                            type="object" class="oe_highlight"
                            invisible="state != 'ready'"/>

                    <button name="desvincular" string="Desvincular OS"
                            type="object"
                            invisible="state == 'delivered'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="received,sent,in_process,in_transit,ready,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="codigo_orden_reclamo"/>
                        <h1>
                            <field name="codigo_orden_reclamo" readonly="1"/>
                        </h1>
                        <label for="cod_asignado" string="Código Asignado"/>
                        <h2>
                            <field name="cod_asignado" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group name="claim_details" string="Detalles del Cliente">
                            <field name="partner_id" widget="res_partner_many2one"
                                   readonly="state != 'received'"/>
                            <field name="partner_shipping_id"
                                   widget="res_partner_many2one"
                                   domain="['|', ('id', '=', partner_id), ('parent_id', '=', partner_id)]"
                                   context="{'default_parent_id': partner_id, 'default_type': 'delivery'}"
                                   readonly="state != 'received'"/>
                            <field name="pricelist_id" groups="product.group_product_pricelist"
                                   readonly="state != 'received'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="user_id" widget="many2one_avatar_user"
                                   readonly="state != 'received'"/>
                            <field name="company_id" groups="base.group_multi_company" optional="show"
                                   readonly="state != 'received'"/>
                            <field name="lorder_id"/>
                        </group>
                        <group name="technical_details" string="Información de Lavandería">
                            <field name="clean_start_time" readonly="state != 'received'"/>
                            <field name="clean_end_time" readonly="state != 'received'"/>
                            <field name="fiscal_position" readonly="state != 'received'"/>
                            <field name="porcentaje_iva_aplicado" invisible="1"/>
                            <field name="invoice_ref_id"/>
                            <field name="delivery_guide_ref"/>
                            <field name="dispatch_guide_ref"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de Reclamo" name="claim_lines">
                            <field name="service_claim_lines" readonly="state != 'received'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="color"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom" groups="uom.group_uom"/>
                                    <field name="price_unit"/>
                                    <field name="discount" groups="sale.group_discount_per_so_line"/>
                                    <field name="tax_id" widget="many2many_tags"/>
                                    <field name="price_subtotal" decoration-bf="1"/>
                                    <field name="claim_type_id"/>
                                    <field name="method_id"/>
                                    <field name="observacion" optional="show"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_prendas"/>
                                <field name="amount_untaxed" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator"
                                       widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <div class="clearfix"/>
                        </page>
                        <page string="Observaciones Internas" name="internal_notes">
                            <field name="informacion" placeholder="Añada notas internas aquí..."
                                   readonly="state != 'received'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_laundry_claim_kanban" model="ir.ui.view">
        <field name="name">laundry.claim.kanban</field>
        <field name="model">laundry.claim</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    group_create="false" group_delete="false">
                <field name="state"/>
                <field name="cod_asignado"/>
                <field name="codigo_orden_reclamo"/>
                <field name="partner_id"/>
                <field name="clean_start_time"/>
                <field name="amount_total"/>
                <field name="total_prendas"/>
                <field name="currency_id"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="codigo_orden_reclamo"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle">
                                        <field name="cod_asignado"/>
                                    </small>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="partner_id"/>
                                <br/>
                                <small><field name="clean_start_time" widget="date"/></small>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge text-bg-secondary">
                                        <field name="total_prendas"/> prendas
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <strong>
                                        <field name="amount_total" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot -->
    <record id="view_laundry_claim_pivot" model="ir.ui.view">
        <field name="name">laundry.claim.pivot</field>
        <field name="model">laundry.claim</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Reclamos" disable_linking="false">
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="total_prendas" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Gráfico -->
    <record id="view_laundry_claim_graph" model="ir.ui.view">
        <field name="name">laundry.claim.graph</field>
        <field name="model">laundry.claim</field>
        <field name="arch" type="xml">
            <graph string="Reclamos" type="bar" stacked="true">
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Lista -->
    <record id="view_laundry_claim_view_list" model="ir.ui.view">
        <field name="name">laundry.claim.list</field>
        <field name="model">laundry.claim</field>
        <field name="arch" type="xml">
            <list string="Reclamos"
                  sample="1"
                  multi_edit="1"
                  decoration-success="state == 'delivered'"
                  decoration-warning="state in ('ready', 'in_transit')"
                  decoration-info="state in ('sent', 'in_process')"
                  decoration-muted="state == 'received'">

                <field name="cod_asignado" decoration-bf="1"/>
                <field name="codigo_orden_reclamo" optional="show"/>

                <field name="partner_id" widget="res_partner_many2one"/>

                <field name="clean_start_time" string="Fecha Inicio"/>
                <field name="lorder_id" optional="show"/>
                <field name="total_prendas" sum="Total Prendas"/>
                <field name="amount_total"
                       widget="monetary"
                       decoration-bf="1"
                       sum="Total Reclamos"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'delivered'"
                       decoration-warning="state in ('ready', 'in_transit')"
                       decoration-info="state in ('sent', 'in_process')"
                       decoration-muted="state == 'received'"/>
            </list>
        </field>
    </record>

    <!-- Búsqueda -->
    <record id="view_laundry_claim_search" model="ir.ui.view">
        <field name="name">laundry.claim.search</field>
        <field name="model">laundry.claim</field>
        <field name="arch" type="xml">
            <search string="Reclamos">
                <field name="codigo_orden_reclamo"/>
                <field name="partner_id"/>
                <filter string="Recibido" name="recibido"
                        domain="[('state','=','received')]"/>
                <filter string="En Proceso" name="en_proceso"
                        domain="[('state','=','in_process')]"/>
                <filter string="Entregado" name="entregado"
                        domain="[('state','=','delivered')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="por_cliente"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="por_estado"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_laundry_claim" model="ir.actions.act_window">
        <field name="name">Reclamos</field>
        <field name="res_model">laundry.claim</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_laundry_claim_search"/>
    </record>

    <menuitem id="menu_laundry_claims"
              name="Reclamos"
              parent="laundry_management.menu_laundry_root"
              action="action_laundry_claim"
              sequence="3"/>

</odoo>