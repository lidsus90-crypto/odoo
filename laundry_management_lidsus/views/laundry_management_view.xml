<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Orden de Servicio Lavandería
    ================================================================ -->

    <!-- Formulario -->
    <record id="view_laundry_management_form" model="ir.ui.view">
        <field name="name">laundry.management.form</field>
        <field name="model">laundry.management</field>
        <field name="arch" type="xml">
            <form string="Orden de Servicio">
                <header>
                    <button name="confirmar" string="Entregar"
                            type="object" class="oe_highlight"
                            invisible="state not in ['ready', 'claim']"/>

                    <button name="view_invoice" string="Crear Factura"
                            type="object"
                            invisible="facturado == True"/>

                    <button name="crear_reclamo" string="Crear Reclamo"
                            type="object"
                            invisible="state != 'ready'"/>

                    <button name="action_send_whatsapp"
                            string="Enviar por WhatsApp"
                            type="object"
                            icon="fa-whatsapp"
                            class="btn-success"
                            invisible="not id"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="received,sent,in_process,in_transit,ready,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="tag_asignado"/>
                        <h1>
                            <field name="tag_asignado" readonly="1" placeholder="Ej: TAG-001"/>
                        </h1>
                    </div>
                    <group>
                        <group name="customer_info" string="Información del Cliente">
                            <field name="codigo_orden_servicio" readonly="1"/>
                            <field name="partner_id" widget="res_partner_many2one"
                                   readonly="state != 'received'"/>
                            <field name="partner_shipping_id"
                                   widget="res_partner_many2one"
                                   domain="['|', ('id', '=', partner_id), ('parent_id', '=', partner_id)]"
                                   context="{'default_parent_id': partner_id, 'default_type': 'delivery'}"
                                   readonly="state != 'received'"/>
                            <field name="whatsapp_mobile"
                                   placeholder="Ej: +593987654321"/>
                            <field name="pricelist_id" groups="product.group_product_pricelist"
                                   readonly="state != 'received'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="user_id" widget="many2one_avatar_user"
                                   readonly="state != 'received'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'received'"/>
                            <field name="planta_id" options="{'no_create': True}"
                                   readonly="state != 'received'"/>
                        </group>
                        <group name="process_info" string="Estado y Tiempos">
                            <field name="clean_start_time" readonly="state != 'received'"/>
                            <field name="clean_end_time"/>
                            <field name="fiscal_position" options="{'no_create': True}"
                                   readonly="state != 'received'"/>
                            <field name="facturado" widget="boolean_toggle"/>
                            <field name="invoice_ref_id" invisible="not facturado"/>
                            <field name="delivery_guide_ref" optional="show"/>
                            <field name="dispatch_guide_ref" optional="show"/>
                            <field name="claim_ref" invisible="not claim_ref"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de Servicio" name="service_lines">
                            <field name="service_lines" readonly="state != 'received'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="color"/>
                                    <field name="product_uom_qty" string="Cant. Pedida"/>
                                    <field name="product_uom" groups="uom.group_uom"/>
                                    <field name="cantp" string="Cant. Procesada"/>
                                    <field name="price_unit"/>
                                    <field name="discount" groups="sale.group_discount_per_so_line"/>
                                    <field name="tax_id" widget="many2many_tags" optional="show"/>
                                    <field name="price_subtotal" decoration-bf="1"/>
                                    <field name="method_id" optional="show"/>
                                    <field name="tiempo"/>
                                    <field name="method_type_id" widget="many2many_tags" optional="hide"/>
                                    <field name="observacion" optional="show"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_prendas" decoration-bf="1"/>
                                <field name="amount_untaxed" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <div class="clearfix"/>
                        </page>
                        <page string="Notas Internas" name="internal_notes">
                            <field name="informacion" placeholder="Añada detalles adicionales sobre la orden..."
                                   readonly="state != 'received'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_laundry_management_kanban" model="ir.ui.view">
        <field name="name">laundry.management.kanban</field>
        <field name="model">laundry.management</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    group_create="false" group_delete="false">
                <field name="state"/>
                <field name="tag_asignado"/>
                <field name="partner_id"/>
                <field name="clean_start_time"/>
                <field name="amount_total"/>
                <field name="total_prendas"/>
                <field name="currency_id"/>
                <field name="facturado"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="tag_asignado"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="partner_id"/>
                                <br/>
                                <small><field name="clean_start_time" widget="date"/></small>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span t-if="record.facturado.raw_value"
                                          class="badge text-bg-success">Facturado</span>
                                    <span t-else=""
                                          class="badge text-bg-warning">Sin factura</span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <strong>
                                        <field name="amount_total" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot -->
    <record id="view_laundry_management_pivot" model="ir.ui.view">
        <field name="name">laundry.management.pivot</field>
        <field name="model">laundry.management</field>
        <field name="arch" type="xml">
            <pivot string="Análisis Órdenes de Servicio" disable_linking="false">
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="total_prendas" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Gráfico -->
    <record id="view_laundry_management_graph" model="ir.ui.view">
        <field name="name">laundry.management.graph</field>
        <field name="model">laundry.management</field>
        <field name="arch" type="xml">
            <graph string="Órdenes de Servicio" type="bar" stacked="true">
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Lista -->
    <record id="view_laundry_management_view_list" model="ir.ui.view">
        <field name="name">laundry.management.list</field>
        <field name="model">laundry.management</field>
        <field name="arch" type="xml">
            <list string="Órdenes de Servicio"
                  sample="1"
                  multi_edit="1"
                  decoration-success="state == 'delivered'"
                  decoration-warning="state in ('ready', 'in_transit')"
                  decoration-info="state in ('sent', 'in_process')"
                  decoration-muted="state == 'received'">
                <field name="tag_asignado" decoration-bf="1"/>
                <field name="codigo_orden_servicio" optional="show"/>
                <field name="partner_id" widget="res_partner_many2one"/>
                <field name="partner_shipping_id" widget="res_partner_many2one" optional="show"/>
                <field name="clean_start_time" string="Inicio"/>
                <field name="clean_end_time" string="Fin Previsto" widget="remaining_days" optional="show"/>
                <field name="total_prendas" sum="Total Prendas" decoration-bf="1"/>
                <field name="amount_total"
                       widget="monetary"
                       sum="Total Facturación"
                       decoration-bf="1"/>
                <field name="facturado"
                       string="¿Facturado?"
                       widget="boolean_favorite"
                       nolabel="0"
                       optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'delivered'"
                       decoration-warning="state in ('ready', 'in_transit')"
                       decoration-info="state in ('sent', 'in_process')"
                       decoration-muted="state == 'received'"/>
            </list>
        </field>
    </record>

    <!-- Búsqueda -->
    <record id="view_laundry_management_search" model="ir.ui.view">
        <field name="name">laundry.management.search</field>
        <field name="model">laundry.management</field>
        <field name="arch" type="xml">
            <search string="Órdenes Lavandería">
                <field name="tag_asignado"/>
                <field name="partner_id"/>
                <filter string="Recibido" name="recibido"
                        domain="[('state','=','received')]"/>
                <filter string="En Proceso" name="en_proceso"
                        domain="[('state','=','in_process')]"/>
                <filter string="Listo" name="listo"
                        domain="[('state','=','ready')]"/>
                <filter string="Entregado" name="entregado"
                        domain="[('state','=','delivered')]"/>
                <filter string="No Facturado" name="no_facturado"
                        domain="[('facturado','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="por_cliente"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="por_estado"
                            context="{'group_by': 'state'}"/>
                    <filter string="Compañía" name="por_empresa"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_laundry_management" model="ir.actions.act_window">
        <field name="name">Órdenes de Servicio</field>
        <field name="res_model">laundry.management</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_laundry_management_search"/>
        <field name="context">{'search_default_por_estado': 0}</field>
    </record>

    <!-- Wizard: Crear facturas agrupadas -->
    <record id="action_laundry_make_invoice" model="ir.actions.act_window">
        <field name="name">Crear Facturas</field>
        <field name="res_model">laundry.make.invoice</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_laundry_management"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- ================================================================
         Menús principales
    ================================================================ -->
    <menuitem id="menu_laundry_root"
              name="Lavandería"
              sequence="50"
              web_icon="laundry_management_lidsus,static/description/icon.png"/>

    <menuitem id="menu_laundry_orders"
              name="Órdenes de Servicio"
              parent="menu_laundry_root"
              action="action_laundry_management"
              sequence="1"/>

</odoo>