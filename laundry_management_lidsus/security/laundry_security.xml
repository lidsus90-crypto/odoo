<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <record id="group_laundry_salesman" model="res.groups">
        <field name="name">Lavandería / Vendedor</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_laundry_manager" model="res.groups">
        <field name="name">Lavandería / Gerente</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="implied_ids" eval="[(4, ref('group_laundry_salesman'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_laundry_planta" model="res.groups">
        <field name="name">Lavandería / Planta</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</data>
<data noupdate="1">

    <record model="ir.rule" id="laundry_management_rule">
        <field name="name">Órdenes Lavandería multi-empresa</field>
        <field ref="model_laundry_management" name="model_id"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_laundry_salesman'))]"/>
    </record>

    <record model="ir.rule" id="laundry_delivery_guide_rule">
        <field name="name">Guías Entrega multi-empresa</field>
        <field ref="model_laundry_delivery_guide" name="model_id"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_laundry_salesman'))]"/>
    </record>

    <record model="ir.rule" id="laundry_dispatch_guide_rule">
        <field name="name">Guías Despacho multi-empresa</field>
        <field ref="model_laundry_dispatch_guide" name="model_id"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_laundry_salesman'))]"/>
    </record>

    <record model="ir.rule" id="laundry_claim_rule">
        <field name="name">Reclamos Lavandería multi-empresa</field>
        <field ref="model_laundry_claim" name="model_id"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_laundry_salesman'))]"/>
    </record>

</data>
</odoo>
